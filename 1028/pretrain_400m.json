{
  "_comment_data": "单分片 pile_train_00.h5 ≈ 9.81B tokens; 400M 模型 Chinchilla ~8B，一遍刚好",
  "train_path": "data/pile/pile_train_00.h5",
  "dev_path":   "data/pile/pile_dev.h5",

